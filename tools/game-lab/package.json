{
  "name": "orbix-game-development-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated, free open-source game development tooling; does not change Orbix production bundles.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc --noEmit && vite build",
    "verify": "node scripts/verify-tools.mjs",
    "assets:inspect": "node scripts/assets.mjs inspect",
    "assets:optimize": "node scripts/assets.mjs optimize",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/rapier": "2.2.0",
    "ecctrl": "2.0.2",
    "howler": "2.2.4",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/howler": "^2.2.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
